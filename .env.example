# 1. Supabase Database & Auth (Get from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. WhatsApp Order Hotline Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=923109361932
NEXT_PUBLIC_PHONE_DISPLAY="0310-9361932"

# 3. Admin Portal Authorization (Comma-separated admin emails)
ADMIN_EMAILS="farmfreshdairy28@gmail.com"

# 4. Transactional Email System (Resend - Server-side only)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# Senders: Use your verified domain (e.g. "Farm Fresh Dairy <orders@farmfreshdairy.pk>")
# Or testing domain ("Farm Fresh Dairy <onboarding@resend.dev>")
EMAIL_FROM="Farm Fresh Dairy <orders@farmfreshdairy.pk>"
ADMIN_ORDER_EMAIL=farmfreshdairy28@gmail.com
NEXT_PUBLIC_APP_URL=https://www.farmfreshdairyproducts.com

# 5. App Settings & Analytics
NEXT_PUBLIC_APP_NAME="Farm Fresh Dairy"
